# ── Knowledge Factory — Environment Template ─────────────────────
# Copy this to .env and fill in your real values.
# NEVER commit the actual .env file to version control.

# Database (SQLite for dev, PostgreSQL for production)
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/knowledge_factory
DATABASE_URL=sqlite+aiosqlite:///./knowledge_factory.db

# CORS — comma-separated origins allowed to make API requests
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8001

# Sentry DSN — set for production error tracking (optional in dev)
SENTRY_DSN=

# Debug mode — enable for dev, disable for production
DEBUG=true

# JWT Secret — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-real-secret

# AI Question Generation
AI_API_KEY=your-ai-api-key

# Code Execution Sandbox URL
SANDBOX_URL=http://localhost:8000

# Seed credentials for initial admin/HR accounts
SEED_ADMIN_PASSWORD=Admin@12345
SEED_HR_PASSWORD=Hr@12345
