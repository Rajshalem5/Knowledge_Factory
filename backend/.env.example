# ── Application ────────────────────────────────────────────────────
APP_NAME=Knowledge Factory
APP_VERSION=0.1.0
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://kf_user:kf_password@localhost:5432/knowledge_factory
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT / Security ─────────────────────────────────────────────────
# Generate with: ssh-keygen -t rsa -b 4096 -m PEM -f jwt_private.pem
# Then extract public key: openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ── AI / LLM ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5
AI_DAILY_SPEND_CAP_USD=50.0

# ── Code Execution Sandbox ────────────────────────────────────────
SANDBOX_URL=http://localhost:2358
SANDBOX_API_KEY=

# ── Object Storage (S3) ───────────────────────────────────────────
S3_BUCKET_NAME=knowledge-factory
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Email ──────────────────────────────────────────────────────────
EMAIL_FROM_ADDRESS=noreply@knowledgefactory.io
SENDGRID_API_KEY=

# ── Proctoring ─────────────────────────────────────────────────────
PROCTORING_MAX_WARNINGS=3
PROCTORING_EVENT_INTERVAL_SECONDS=5
