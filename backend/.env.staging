# Staging Environment Template
# Copy to .env.staging and fill in real values
DEBUG=false
DATABASE_URL=postgresql+asyncpg://kf_user:password@staging-pg-host:5432/knowledge_factory_staging
CORS_ORIGINS=https://staging.knowledge-factory.com
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=3
REDIS_URL=redis://staging-redis-host:6379/0
SECURE_COOKIES=true
MAINTENANCE_MODE=false
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
LOGIN_RATE_LIMIT=5/15min
CODE_EXEC_RATE_LIMIT=20/minute