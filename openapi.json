{
  "openapi": "3.1.0",
  "info": {
    "title": "Knowledge Factory API",
    "version": "1.0.0",
    "description": "AI-powered intern hiring and evaluation platform API"
  },
  "servers": [
    {
      "url": "https://your-domain.com/api",
      "description": "Production server"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Login",
        "description": "Authenticate user or candidate and return JWT token",
        "tags": ["auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "401": {
            "description": "Incorrect email or password"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Register Candidate",
        "description": "Register a new candidate for the active hiring cycle",
        "tags": ["auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CandidateRegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Candidate registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "400": {
            "description": "Registration failed"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Get Current User",
        "description": "Get current user profile from JWT",
        "tags": ["auth"],
        "responses": {
          "200": {
            "description": "User profile retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            }
          }
        }
      }
    },
    "/candidates/": {
      "get": {
        "summary": "List Candidates",
        "description": "List candidates for the current tenant with pagination",
        "tags": ["candidates"],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "Page number"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": "Number of items per page"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by candidate status"
          }
        ],
        "responses": {
          "200": {
            "description": "Candidates retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandidateListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/candidates/{candidate_id}": {
      "get": {
        "summary": "Get Candidate Detail",
        "description": "Get detailed profile of a candidate",
        "tags": ["candidates"],
        "parameters": [
          {
            "name": "candidate_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Candidate retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandidateRead"
                }
              }
            }
          },
          "404": {
            "description": "Candidate not found"
          }
        }
      }
    },
    "/candidates/{candidate_id}/status": {
      "patch": {
        "summary": "Update Candidate Status",
        "description": "Manually override candidate status",
        "tags": ["candidates"],
        "parameters": [
          {
            "name": "candidate_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CandidateStatusUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Candidate status updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandidateRead"
                }
              }
            }
          },
          "404": {
            "description": "Candidate not found"
          }
        }
      }
    },
    "/candidates/bulk-upload": {
      "post": {
        "summary": "Bulk Upload Candidates",
        "description": "Upload a CSV/Excel file and get a preview of records to be created",
        "tags": ["candidates"],
        "responses": {
          "200": {
            "description": "Bulk upload preview retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkUploadPreview"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "required": ["email", "password"]
      },
      "CandidateRegisterRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 255
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "college": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "cgpa": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "passed_out_year": {
            "type": "integer"
          },
          "language_choice": {
            "type": "string"
          }
        },
        "required": ["name", "email", "password", "college", "branch", "cgpa", "passed_out_year", "language_choice"]
      },
      "Token": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserRead"
          }
        },
        "required": ["access_token", "token_type", "user"]
      },
      "UserRead": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["id", "email", "name", "role"]
      },
      "CandidateBase": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "college": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "cgpa": {
            "type": "number"
          },
          "passed_out_year": {
            "type": "integer"
          },
          "language_choice": {
            "type": "string"
          }
        }
      },
      "CandidateRead": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CandidateBase"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "type": "string"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "tenant_id": {
                "type": "string",
                "format": "uuid"
              },
              "cycle_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": ["id", "status", "created_at", "tenant_id", "cycle_id"]
          }
        ]
      },
      "CandidateListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CandidateRead"
            }
          },
          "pagination": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer"
              },
              "limit": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              },
              "total_pages": {
                "type": "integer"
              }
            }
          }
        }
      },
      "CandidateStatusUpdate": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": ["status"]
      },
      "BulkUploadPreview": {
        "type": "object",
        "properties": {
          "batch_id": {
            "type": "string"
          },
          "total_records": {
            "type": "integer"
          },
          "valid_records": {
            "type": "integer"
          },
          "invalid_records": {
            "type": "integer"
          },
          "preview": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}